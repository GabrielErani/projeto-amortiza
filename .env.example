# Copie este arquivo para `.env` e preencha com os dados do seu projeto Supabase.
# Painel: https://supabase.com/dashboard -> Project Settings -> API
# Variáveis com prefixo EXPO_PUBLIC_ são embutidas no app pelo Expo (não coloque segredos aqui).
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXX
